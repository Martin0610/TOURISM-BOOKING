{
  "info": {
    "name": "Tourism Booking API",
    "description": "Complete API collection for TourEase Tourism Package Booking System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "packageId", "value": "", "type": "string" },
    { "key": "bookingId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "  pm.collectionVariables.set('adminToken', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Martin JV\",\n  \"email\": \"mjv3140@gmail.com\",\n  \"password\": \"password123\",\n  \"phone\": \"+91 7200336447\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "  pm.collectionVariables.set('adminToken', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mjv3140@gmail.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Get Current User (me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Packages",
      "item": [
        {
          "name": "Get All Packages",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/packages", "host": ["{{baseUrl}}"], "path": ["api", "packages"] }
          }
        },
        {
          "name": "Get All Packages - Filter by Category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/packages?category=Beach",
              "host": ["{{baseUrl}}"],
              "path": ["api", "packages"],
              "query": [{ "key": "category", "value": "Beach" }]
            }
          }
        },
        {
          "name": "Get All Packages - Search",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/packages?search=goa",
              "host": ["{{baseUrl}}"],
              "path": ["api", "packages"],
              "query": [{ "key": "search", "value": "goa" }]
            }
          }
        },
        {
          "name": "Get Package by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/packages/{{packageId}}", "host": ["{{baseUrl}}"], "path": ["api", "packages", "{{packageId}}"] }
          }
        },
        {
          "name": "Create Package (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.success && res.data && res.data.id) {",
                  "  pm.collectionVariables.set('packageId', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Beach Package\",\n  \"destination\": \"Goa\",\n  \"state\": \"Goa\",\n  \"shortDescription\": \"A beautiful beach getaway\",\n  \"description\": \"Enjoy the beautiful beaches of Goa with this amazing package.\",\n  \"pricePerPerson\": 12000,\n  \"durationDays\": 4,\n  \"durationNights\": 3,\n  \"category\": \"Beach\",\n  \"availableSeats\": 15,\n  \"hotelCategory\": \"3 Star\",\n  \"accommodation\": \"Beach-facing hotel\",\n  \"mealsIncluded\": \"Daily breakfast\",\n  \"transportIncluded\": false,\n  \"sightseeingIncluded\": true,\n  \"bestTimeToVisit\": \"November to February\",\n  \"itinerary\": \"Day 1: Arrival\\nDay 2: Beach tour\\nDay 3: Water sports\\nDay 4: Departure\",\n  \"inclusions\": \"Hotel accommodation\\nDaily breakfast\\nAirport transfers\",\n  \"exclusions\": \"Airfare\\nPersonal expenses\",\n  \"cancellationPolicy\": \"Free cancellation up to 7 days before travel.\",\n  \"imageUrl\": \"https://images.unsplash.com/photo-1512343879784-a960bf40e7f2?w=800\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/packages", "host": ["{{baseUrl}}"], "path": ["api", "packages"] }
          }
        },
        {
          "name": "Update Package (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pricePerPerson\": 14000,\n  \"availableSeats\": 10\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/packages/{{packageId}}", "host": ["{{baseUrl}}"], "path": ["api", "packages", "{{packageId}}"] }
          }
        },
        {
          "name": "Delete Package (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/packages/{{packageId}}", "host": ["{{baseUrl}}"], "path": ["api", "packages", "{{packageId}}"] }
          }
        }
      ]
    },
    {
      "name": "Departures",
      "item": [
        {
          "name": "Get Departures by Destination",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/departures?destination=Goa",
              "host": ["{{baseUrl}}"],
              "path": ["api", "departures"],
              "query": [{ "key": "destination", "value": "Goa" }]
            }
          }
        },
        {
          "name": "Get All Departures",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/departures", "host": ["{{baseUrl}}"], "path": ["api", "departures"] }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.success && res.data && res.data.id) {",
                  "  pm.collectionVariables.set('bookingId', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"packageId\": \"{{packageId}}\",\n  \"travelDate\": \"2025-06-15\",\n  \"numberOfPeople\": 4,\n  \"departureLocationId\": \"\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
          }
        },
        {
          "name": "Get My Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
          }
        },
        {
          "name": "Get Booking by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "{{bookingId}}"] }
          }
        },
        {
          "name": "Update Booking Status (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "{{bookingId}}"] }
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "{{bookingId}}"] }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Razorpay Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"{{bookingId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/payments/create-order", "host": ["{{baseUrl}}"], "path": ["api", "payments", "create-order"] }
          }
        },
        {
          "name": "Verify Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"razorpay_order_id\": \"order_xxxx\",\n  \"razorpay_payment_id\": \"pay_xxxx\",\n  \"razorpay_signature\": \"signature_xxxx\",\n  \"bookingId\": \"{{bookingId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/payments/verify", "host": ["{{baseUrl}}"], "path": ["api", "payments", "verify"] }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/stats", "host": ["{{baseUrl}}"], "path": ["api", "admin", "stats"] }
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/users", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users"] }
          }
        },
        {
          "name": "Get All Payments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/payments", "host": ["{{baseUrl}}"], "path": ["api", "admin", "payments"] }
          }
        },
        {
          "name": "Get Revenue Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/revenue", "host": ["{{baseUrl}}"], "path": ["api", "admin", "revenue"] }
          }
        }
      ]
    },
    {
      "name": "Validation Tests",
      "item": [
        {
          "name": "Register - Missing Fields (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"notvalid\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Access Protected Route - No Token (401)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Create Package - Not Admin (403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/packages", "host": ["{{baseUrl}}"], "path": ["api", "packages"] }
          }
        },
        {
          "name": "Get Package - Not Found (404)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/packages/invalid-id-123", "host": ["{{baseUrl}}"], "path": ["api", "packages", "invalid-id-123"] }
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    }
  ]
}
